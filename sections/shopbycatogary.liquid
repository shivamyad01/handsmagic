<!-- sections/shop-by-category.liquid -->
<div class="shop-by-category-wrapper" style="background: #ffeddb; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <style>
    .category-grid {
      display: flex;
      gap: 20px;
      justify-content: center;
    }

    .category-item {
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      text-align: center;
    }

    .category-item img {
      width: 100%;
      height: auto;
      display: block;
    }

    @media (min-width: 768px) {
      .category-grid {
        flex-wrap: wrap;
      }

      .category-item {
        flex: 0 0 30%;
        max-width: 30%;
      }
    }

    @media (max-width: 767px) {
      .category-grid {
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        gap: 12px;
        padding-left: 1rem;
        margin: 0 -1rem;
        scrollbar-width: none; /* Firefox */
      }

      .category-grid::-webkit-scrollbar {
        display: none; /* Chrome, Safari, Opera */
      }

      .category-item {
        flex: 0 0 50%;
        max-width: 50%;
        scroll-snap-align: start;
      }
    }
  </style>

  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 style="text-align: {{ section.settings.heading_align }}; font-size: {{ section.settings.heading_font_size }}px; font-weight: 700; margin-bottom: 40px; color: #5e2b31;">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="category-grid">
      {% for block in section.blocks %}
        <div class="category-item">
          {% if block.settings.collection != blank %}
            <a href="{{ block.settings.collection.url }}">
          {% endif %}
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Category Image">
              {% endif %}
          {% if block.settings.collection != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop By Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop By Category"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Font Size",
      "min": 14,
      "max": 60,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Link to Collection"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Shop By Category",
      "category": "Custom",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
